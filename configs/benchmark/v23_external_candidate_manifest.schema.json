{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARGOS v23 fresh external image case",
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "source_dataset_id",
    "study_fingerprint_sha256",
    "files",
    "ground_truth_read",
    "lesion_masks_used",
    "research_only",
    "clinical_use_allowed"
  ],
  "properties": {
    "schema": {
      "const": "argos-v23-external-image-case-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^anon-[a-z0-9][a-z0-9-]{7,95}$"
    },
    "source_dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "study_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "relative_path", "bytes", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "ground_truth_read": {"const": false},
    "lesion_masks_used": {"const": false},
    "research_only": {"const": true},
    "clinical_use_allowed": {"const": false}
  },
  "additionalProperties": false
}
