{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARGOS v23 protected external label",
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "label",
    "target_condition",
    "reference_standard",
    "research_only",
    "clinical_use_allowed"
  ],
  "properties": {
    "schema": {
      "const": "argos-v23-external-protected-label-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^anon-[a-z0-9][a-z0-9-]{7,95}$"
    },
    "label": {
      "enum": ["POSITIVE", "NEGATIVE"]
    },
    "target_condition": {
      "const": "focal_liver_lesion_suspicion"
    },
    "reference_standard": {
      "enum": [
        "public_expert_annotation",
        "independent_expert_review"
      ]
    },
    "research_only": {
      "const": true
    },
    "clinical_use_allowed": {
      "const": false
    }
  },
  "additionalProperties": false
}
